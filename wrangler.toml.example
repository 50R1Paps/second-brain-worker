name = "second-brain"
main = "src/worker.ts"
compatibility_date = "2024-09-23"
compatibility_flags = ["nodejs_compat", "global_fetch_strictly_public"]
preview_urls = false

# Store explicit sanitized events, not invocation URLs/bodies/OAuth codes.
[observability]
enabled = true
head_sampling_rate = 1

[observability.logs]
enabled = true
invocation_logs = false

[[r2_buckets]]
binding = "RAW_BUCKET"
bucket_name = "second-brain-raw"

[[d1_databases]]
binding = "DB"
database_name = "second-brain"
database_id = "<your-d1-database-id>"
migrations_dir = "migrations"

[[vectorize]]
binding = "VECTORIZE"
index_name = "second-brain-embeddings"

[ai]
binding = "AI"

# OAuth — KV for state/CSRF tokens
[[kv_namespaces]]
binding = "OAUTH_KV"
id = "<your-kv-namespace-id>"

# Durable Object for McpAgent
[durable_objects]
bindings = [
  { name = "OWNER_MCP", class_name = "OwnerMCP" },
  { name = "MUTATIONS", class_name = "FileCoordinator" }
]

[[migrations]]
tag = "v1"
new_sqlite_classes = ["SecondBrainMCP"]

[[migrations]]
tag = "v2-security-cutover"
new_sqlite_classes = ["FileCoordinator", "OwnerMCP"]
deleted_classes = ["SecondBrainMCP"]

# Approximate limits per Cloudflare location; use account-unique namespaces.
[[ratelimits]]
name = "AUTH_RATE_LIMITER"
namespace_id = "15362791"
simple = { limit = 20, period = 60 }

[[ratelimits]]
name = "REQUEST_RATE_LIMITER"
namespace_id = "15362792"
simple = { limit = 120, period = 60 }

# OAuth secrets (set via `wrangler secret put`):
# GITHUB_CLIENT_ID
# GITHUB_CLIENT_SECRET
# COOKIE_ENCRYPTION_KEY

# REST API bearer token (all /api/* except GET /api/health):
# API_TOKEN

# GitHub webhook sync secrets (set via `wrangler secret put`):
# WEBHOOK_SECRET
# GITHUB_TOKEN
# GITHUB_TOKEN_EXPIRY (ISO date string, e.g. 2026-09-25T00:00:00Z)

# Cron trigger: daily check for token expiry reminder
[triggers]
crons = ["0 9 * * *"]
