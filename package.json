{
  "name": "second-brain-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply second-brain --local",
    "db:migrate:remote": "wrangler d1 migrations apply second-brain --remote",
    "setup": "tsx scripts/setup.ts",
    "setup:dry": "tsx scripts/setup.ts --dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.1",
    "@cloudflare/workers-types": "5.20261113.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "5.1.0",
    "wrangler": "4.161.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "agents": "0.33.0",
    "hono": "4.13.18",
    "re2js": "2.10.0",
    "zod": "4.6.7"
  }
}
